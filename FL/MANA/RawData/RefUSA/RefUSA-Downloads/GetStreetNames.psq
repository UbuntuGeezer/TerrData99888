-- *;
.open '$pathbase/$scpath/SCPA_05-20.db'
select distinct trim(substr("situsaddress(propertyaddress)",7,35)) Street
from Data0520
where parceldesc1 like '%<area-name>%'
and SitusZipCode like '<zip>%'
and length(Street) > 0;
.quit
-- * END GetStreetNames.sql;
