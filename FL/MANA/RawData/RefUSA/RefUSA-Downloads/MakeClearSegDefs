ifndef AWK
 AWK = mawk
endif

.PHONY : Always
.ONESHELL : ;

projpath = $(codebase)/Projects-Geany/SpecialRUdb
specpath = $(pathbase)/RawData/RefUSA/RefUSA-Downloads/Special
bashpath = $(codebase)/Procs-Dev
altproj = $(codebase)/Projects-Geany/AnySQLtoSH
targpath = $(pathbase)/$(rupath)/Terr264

# ClearTerrSegsDB.sh primary target.
# $(specpath)/preambleBldSt.sh
#=======================================================================
Always : $(specpath)/ClearSegDefs.sql
	cd $(altproj);./DoSed.sh $(specpath) ClearSegDefs preambleClear.sh
	$(MAKE) -f $(altproj)/MakeAnySQLtoSH
	if ! test -f $(specpath)/ClearSegDefs.sh;then \
	 echo " ** ClearSegDefs.sh build FAILED **";exit 1;fi
	$(specpath)/ClearSegDefs.sh
	sqlite3 < $(specpath)/Jumpto.std
	if test -f  $(targpath)/segdefs.csv;then \
	 echo "  /Terr264/segdefs.csv definitions remain...";fi

	
$(specpath)/ClearSegDefs.sql : ;
	if ! test -f $@;then \
	 echo "** missing ClearSegDefs.sql for ClearSegDefs.sh build **";exit 1;fi

