# Make.AnyTIDList - Makefile template (RU) for AnyTIDList to extract TerrIDs from <special-db>.db.
# 2023-11-25.	wmk.	(automated) Version 3.0.6 Make old paths removed.
# 2023-09-27   wmk.   (automated) ver2.0 Make fixes.
#	2/2/23.	wmk.
#
# Primary target: /RefUSA-Downloads/Special/<special-db>.TIDList.txt
#
# Entry. 'sed' run to edit the <special-db> name w wwww into this makefile
#	resulting in Make.AnyTIDList for make utility
#
# Exit.	/Special/<special-db>.TIDList.txt contains list of territories that
#	will be affected whenever <special-db>.db is updated.
#
# Modification History.
# ---------------------
# 11/25/23.	wmk.	(automated) Version 3.0.6 Make old paths removed.
# 5/4/22.   wmk.	(automated) path corrections.
# 2/2/23.	wmk.	*codebase support; .sh recipe updated to use AnySQLtoSH;
#			 comments tidied.
# Legacy  mods.
# 11/10/21.	wmk.	original code.
#
# Make.AnyTIDList runs a query to extract TerrIDs from the TerrList table in db
# <special-db>.db. The query results are output to file <special-db>.TIDList.txt.
# This file may then be copied into TIDList.txt files in projects such as
# RemakeSpecTerrs. The TID list provides the list of territories to be re-made
# whenever <special-db> is newer than either Specyyy_RU.db or Terryyy_RU.db in
# each territory in the list.






ifndef AWK
 AWK = mawk
endif

.PHONY : ;
.ONESHELL : ;

projpath = $(codebase)/Projects-Geany/SpecialRUdb
specpath = $(pathbase)/RawData/RefUSA/RefUSA-Downloads/Special
bashpath = $(codebase)/Procs-Dev
altproj = $(codebase)/Projects-Geany/AnySQLtosH

# <special-db>.TIDList.txt primary target.
#=====================================================================================
$(specpath)/vvvvv.TIDList.txt : $(specpath)/vvvvv.db $(specpath)/AnyTIDList.sql \
 $(specpath)/AnyTIDList.sh
	$(specpath)/AnyTIDList.sh
	sed -i '1s?^?#?' $@

$(specpath)/AnyTIDList.sh : $(specpath)/AnyTIDList.sql
	cd $(altproj);./DoSed.sh  $(specpath) AnyTIDList
	$(MAKE) -f $(altproj)/MakeAnySQLtoSH

$(specpath)/AnyTIDList.sql : ;
	if ! test $@;then \
	 echo " ** missing AnyTIDList.sql for AnyTIDList.sh build **";exit 1;fi

# end Make.AnyTIDList
