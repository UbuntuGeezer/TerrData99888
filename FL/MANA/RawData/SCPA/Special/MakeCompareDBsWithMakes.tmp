.ONESHELL : ;
.NOTPARALLEL : ;

ifndef folderbase
 ifeq ($(USER),ubuntu)
  folderbase = /media/ubuntu/Windows
 else
  folderbase = $(HOME)
 endif
endif

ifndef codebase
 codebase = $(folderbase)/GitHub/TerritoriesCB/FLsara86777
endif

ifndef pathbase
 pathbase= $(folderbase)/Territories/FL/SARA/86777
endif


 projpath = $(codebase)/Projects-Geany/SyncAllData
 altproj = $(codebase)/Projects-Geany/AnySQLtoSH
targpath = $(pathbase)/$(scpath)/Special

.PHONY  : Always
.ONESHELL : ;

# primary target phony
#==================================================================
Always :
	cd $(altproj);./DoSed.sh $(targpath) CompareDBsWithMakes
	$(MAKE) -f $(altproj)/MakeAnySQLtoSH
	if ! test -f $(targpath)/CompareDBsWithMakes.sh;then \
	 echo "** CompareDBsWithMakes.sh generation failed **";exit 1;fi
	echo "** CompareDBsWithMakes.sh to generate MissingMakes.csv **"
	
#==================================================================
# end MakeCompareDBsWithMakes.tmp
