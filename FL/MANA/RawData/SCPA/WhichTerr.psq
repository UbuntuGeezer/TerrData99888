-- * WhichTerr.psq/sql - SQL query to search Terrxxx_SCBridge table for address.
. \nWhichTerr.psq-out-of-date-exiting\n
.exit 1     -- WhichTerr.psq out of-date
-- *	5/4/24.	wmk.
-- *
-- * Notes. DoSedWhichTerr.sh edits < terrid > into search query.
-- *
.open '$pathbase/$scpath/Terr<terrid>/Terr<terrid>_SC.db'
.separator " "
SELECT 'Terr<terrid>_SC.db matching count = ', count(OwningParcel)
FROM Terr<terrid>_SCBridge
WHERE UnitAddress LIKE '%<addr>%';
.quit
-- * END WhichTerr.sql
